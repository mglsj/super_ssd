---
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { getNotes, partLabel, type Note } from '@/lib/notes';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note, i) => ({
    params: { slug: note.id },
    props: { note, prev: notes[i - 1], next: notes[i + 1] },
  }));
}

interface Props {
  note: Note;
  prev?: Note;
  next?: Note;
}
const { note, prev, next } = Astro.props;
const { Content, headings } = await render(note);
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={note.data.title} description={note.data.description} current={note.id} toc={toc}>
  <header class="mb-10">
    <p class="topic-group">{partLabel(note.data.part)}</p>
    <h1 class="font-serif text-4xl font-semibold tracking-tight md:text-5xl">{note.data.title}</h1>
    <p class="mt-3 font-serif text-xl text-muted-foreground italic">{note.data.description}</p>
  </header>

  <article class="prose-body">
    <Content />
  </article>

  <nav class="mt-16 grid gap-4 border-t pt-6 sm:grid-cols-2" aria-label="Previous and next topic">
    {
      prev && (
        <a href={`${import.meta.env.BASE_URL}${prev.id}/`} class="group">
          <span class="topic-group">← Previous</span>
          <span class="block font-serif text-lg group-hover:text-primary">{prev.data.title}</span>
        </a>
      )
    }
    {
      next && (
        <a href={`${import.meta.env.BASE_URL}${next.id}/`} class="group sm:col-start-2 sm:text-right">
          <span class="topic-group">Next →</span>
          <span class="block font-serif text-lg group-hover:text-primary">{next.data.title}</span>
        </a>
      )
    }
  </nav>
</Base>
